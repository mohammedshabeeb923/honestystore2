# ============================================================
# HONESTY STORE 2 - Production Environment Configuration
# Independent Instance for New Customer / Institution
# ============================================================

PORT=3000

# 1. Store Branding & Identity
STORE_NAME=Honesty Store 2
APP_BASE_URL=https://your-new-store.onrender.com

# 2. Administrator Access (Comma-separated admin emails)
ADMIN_EMAILS=admin@your-institution.edu,manager@your-institution.edu

# 3. Security & CORS
SERVER_SECRET=change-this-to-a-secure-random-secret-key-32-chars
ALLOWED_ORIGINS=https://your-new-store.onrender.com

# 4. Supabase Project B (Brand new project)
# Found in: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-new-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 5. Cashfree Payment Gateway B (Merchant account for Customer B)
# Found in: Cashfree Merchant Dashboard > Developers > API Keys
CASHFREE_APP_ID=CF_APP_ID_FOR_CUSTOMER_B
CASHFREE_SECRET_KEY=cfsk_ma_prod_or_test_secret_for_customer_b
CASHFREE_ENV=SANDBOX # Use 'PRODUCTION' for live UPI transactions

# 6. Automatic Background Reconciliation Token (UptimeRobot / Cron)
# Endpoint: GET https://your-new-store.onrender.com/api/cron/reconcile?key=YOUR_CRON_SECRET
CRON_SECRET=honesty_store_2_reconcile_token_2026
